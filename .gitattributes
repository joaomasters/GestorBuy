# Força LF para código-fonte, independente do core.autocrlf local — Go
# (gofmt) e as ferramentas de CI (rodando em Linux) esperam LF.
*.go text eol=lf
go.mod text eol=lf
go.sum text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Makefile text eol=lf
*.sh text eol=lf

# Frontend (web/) — mesma lógica: LF fixo pra ESLint/Prettier e CI (Linux)
# não brigarem com o CRLF que o Windows injeta no checkout.
*.ts text eol=lf
*.tsx text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
