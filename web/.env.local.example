# Copie para .env.local (nunca commitado — ver .gitignore).
# URL da API Go — chamada só do servidor Next.js (Route Handlers, Server
# Actions, Server Components), nunca exposta ao navegador.

# Local: aponta pra API rodando via `go run ./cmd/api` (ver README na raiz do repo)
INTERNAL_API_URL=http://localhost:8080

# Produção: URL do serviço no Railway
# INTERNAL_API_URL=https://gestorbuy-production.up.railway.app
