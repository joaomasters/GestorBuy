# Copie para .env e ajuste os valores. .env nunca é commitado (ver .gitignore).

HTTP_PORT=8080

# Local (docker-compose): mongodb://localhost:27017
# Atlas (produção): mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_URI=mongodb://localhost:27017
MONGO_DB_NAME=gestorbuy

# Gere um valor forte antes de usar em produção, ex.: openssl rand -hex 32
JWT_SECRET=troque-este-valor-antes-de-ir-para-producao

# URL do frontend — o backend redireciona pra cá depois do callback OAuth
# de um marketplace (ver internal/marketplace).
FRONTEND_URL=http://localhost:3000

# --- Hub OAuth2 de marketplace (opcionais — sem eles, /integrations e
# /mining/*/sync ficam indisponíveis, mas o resto da API funciona normal) ---

# Chave de 32 bytes em base64 pra cifrar tokens de marketplace antes de
# gravar no Mongo (AES-256-GCM, ver internal/platform/crypto).
# Gere com: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Credenciais do app criado em developers.mercadolivre.com.br
ML_CLIENT_ID=
ML_CLIENT_SECRET=
# Precisa bater exatamente com o Redirect URI cadastrado no app do ML.
ML_REDIRECT_URI=http://localhost:8080/integrations/mercadolivre/callback
